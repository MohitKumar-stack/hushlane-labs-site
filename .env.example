# Baked in at build time. Change one of these, then rebuild and redeploy.

# Canonical site URL. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://hushlanelabs.com

# Google Apps Script web app URL. Required for the contact form and lead popup.
NEXT_PUBLIC_SHEETS_WEBHOOK_URL=

# Booking embed / CTA target. Paste a Google Calendar appointment-schedule
# link (include ?gv=true), or a Cal.com link. Contact embeds the Calendar
# iframe. Navbar, hero, CTA sections, and the popup success state use this URL.
# Turn on Google Meet in that scheduler so every booking gets a Meet link.
NEXT_PUBLIC_BOOKING_URL=

# Optional shared string checked by the Apps Script. It is visible in the
# browser bundle because the form is static. It stops casual spam, not a
# determined caller.
NEXT_PUBLIC_FORM_TOKEN=

# Google Tag Manager container. Defaults to GTM-PCW867CZ when unset.
NEXT_PUBLIC_GTM_ID=GTM-PCW867CZ

# PostHog browser analytics. Set these before building and deploying.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Leave blank to disable. Set one, or both. Prefer configuring GA inside GTM.
# Popup events: popup_shown, popup_closed, popup_submitted, booking_clicked.
# Contact / CTA events: form_submit, booking_click.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Search Console HTML tag verification content value, not the whole meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Public LinkedIn company page. Organization sameAs and the footer use this.
# Defaults to the company page when unset.
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/hushlane-labs

# Firebase web app (project hushlanelabs). Public client config.
# Hosting does not need these. They are for a future client feature.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=hushlanelabs.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=hushlanelabs
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=hushlanelabs.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
